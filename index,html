<!DOCTYPE html>

<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Clean Our Community</title>
    <link rel="stylesheet" href="style.css">
</head>

<body>

```
<header>
    <nav class="navbar">
        <div class="logo">🌱 Clean Our Community</div>

        <div class="nav-links">
            <a href="#home">Home</a>
            <a href="#report">Report Pollution</a>
            <a href="#reports">Reports</a>
            <a href="#message">Our Message</a>
        </div>
    </nav>
</header>

<main>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-content">
            <h1>Let's Keep Our Planet Clean 🌍</h1>

            <p>
                See a polluted place? Upload a photo and report it.
                Together, we can encourage citizens and authorities
                to take action and keep our surroundings clean.
            </p>

            <a href="#report" class="btn">Report a Polluted Place</a>
        </div>
    </section>

    <!-- Report Section -->
    <section id="report" class="section">
        <div class="container">

            <h2>📸 Report a Polluted Place</h2>

            <p class="section-intro">
                Upload a photo and tell us what is happening.
                Your report can help bring attention to cleanliness problems.
            </p>

            <form id="reportForm">

                <div class="form-group">
                    <label for="photo">Upload Photo</label>
                    <input
                        type="file"
                        id="photo"
                        accept="image/*"
                        required
                    >
                </div>

                <div id="preview-container" class="preview-container">
                    <img id="photoPreview" src="" alt="Photo Preview">
                </div>

                <div class="form-group">
                    <label for="location">Location</label>
                    <input
                        type="text"
                        id="location"
                        placeholder="Example: Main Market, Pilibhit"
                        required
                    >
                </div>

                <div class="form-group">
                    <label for="pollutionType">Type of Pollution</label>

                    <select id="pollutionType" required>
                        <option value="">Select pollution type</option>
                        <option value="Garbage">Garbage / Waste</option>
                        <option value="Plastic">Plastic Waste</option>
                        <option value="Water Pollution">Water Pollution</option>
                        <option value="Air Pollution">Air Pollution</option>
                        <option value="Sewage">Sewage</option>
                        <option value="Other">Other</option>
                    </select>
                </div>

                <div class="form-group">
                    <label for="description">Describe the Problem</label>

                    <textarea
                        id="description"
                        rows="5"
                        placeholder="Describe the pollution problem..."
                        required
                    ></textarea>
                </div>

                <button type="submit" class="submit-btn">
                    📢 Submit Report
                </button>

            </form>

            <div id="successMessage" class="success-message">
                ✅ Thank you! Your pollution report has been submitted.
            </div>

        </div>
    </section>

    <!-- Reports Section -->
    <section id="reports" class="section reports-section">

        <div class="container">

            <h2>📋 Community Reports</h2>

            <p class="section-intro">
                These reports highlight places that need attention.
            </p>

            <div id="reportsContainer" class="reports-container">

                <div class="empty-message">
                    No reports yet. Be the first person to report a polluted place!
                </div>

            </div>

        </div>

    </section>

    <!-- Message Section -->
    <section id="message" class="message-section">

        <div class="container">

            <h2>🌱 Our Message to Everyone</h2>

            <div class="message-card">

                <p>
                    <strong>To all citizens:</strong>
                    Please do not throw garbage on roads, in rivers,
                    parks, or public places. Use dustbins and encourage
                    others to keep our surroundings clean.
                </p>

                <p>
                    <strong>To government and local authorities:</strong>
                    We request you to take timely action on reported
                    pollution problems, provide adequate waste-management
                    facilities, and help maintain clean and healthy
                    public spaces.
                </p>

                <p class="final-message">
                    🌍 <strong>A clean environment is everyone's responsibility.</strong>
                </p>

            </div>

        </div>

    </section>

</main>

<footer>
    <p>🌱 Clean Our Community | Together for a cleaner future</p>
</footer>

<script src="script.js"></script>
```

</body>
</html>
